# Supabase — preencher localmente ou no provedor de deploy.
# Nunca versione .env.local, senhas ou chaves administrativas.

NEXT_PUBLIC_SUPABASE_URL=https://uaqsvukxgbquouibaogi.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=coloque_a_publishable_key_aqui
NEXT_PUBLIC_USE_PREVIEW_DATA=false

# Usada somente em backend/worker. Nunca expor no navegador.
SUPABASE_DB_PASSWORD=altere_e_cadastre_como_secret
SUPABASE_SERVICE_ROLE_KEY=coloque_a_service_role_key_aqui

# URL pública da aplicação. O DNS/domínio será administrado pela Cloudflare.
NEXT_PUBLIC_SITE_URL=https://seu-dominio.com.br

# Integração futura com Instagram/Meta
META_APP_ID=
META_APP_SECRET=

